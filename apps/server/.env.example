# For local Docker Compose, use the same password in both values.
MTERMINAL_POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://mterminal:replace-me@127.0.0.1:5433/mterminal
MTERMINAL_SMTP_URL=smtp://127.0.0.1:1025
MTERMINAL_SMTP_FROM=mterminal@local.example
MTERMINAL_ACCOUNT_MFA_KEY=replace-with-64-random-hex-characters
MTERMINAL_TRUST_ACCOUNT_PROXY=0
PORT=8787
