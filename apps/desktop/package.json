{
  "name": "@mterminal/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mTerminal desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --build",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "database": "node scripts/database.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
