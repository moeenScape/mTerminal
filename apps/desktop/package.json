{
  "name": "@mterminal/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mTerminal desktop application",
  "homepage": "https://github.com/moeenScape/mTerminal",
  "author": "Moeen Ahmmed",
  "desktopName": "mterminal.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron && node scripts/rebuild.mjs",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --linux deb",
    "typecheck": "tsc --build",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "database": "node scripts/database.mjs",
    "rebuild:native": "node scripts/rebuild.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "12.0.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
