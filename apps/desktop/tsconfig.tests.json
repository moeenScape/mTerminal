{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/main/security.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/main/preferences.ts",
    "src/main/storage/**/*.ts",
    "src/main/failures.ts",
    "src/main/diagnostics.ts",
    "src/main/terminal/session.ts",
    "src/main/terminal/shells.ts",
    "src/main/menus.ts",
    "src/renderer/src/components/keyboard.ts"
  ]
}
