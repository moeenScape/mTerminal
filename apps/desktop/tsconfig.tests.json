{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/main/security.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/main/preferences.ts",
    "src/main/storage/**/*.ts",
    "src/main/failures.ts",
    "src/main/diagnostics.ts",
    "src/main/terminal/session.ts",
    "src/main/terminal/shells.ts",
    "src/main/menus.ts",
    "src/renderer/src/components/keyboard.ts",
    "src/renderer/src/features/workspace/terminal-sizing.ts",
    "src/main/terminal/registry.ts",
    "src/renderer/src/features/workspace/tabs.ts",
    "src/main/clipboard.ts",
    "src/renderer/src/features/workspace/terminal-search.ts",
    "src/renderer/src/features/workspace/appearance.ts",
    "src/main/terminal/transport.ts",
    "src/main/terminal/ssh.ts",
    "src/main/terminal/ssh-challenges.ts",
    "src/main/terminal/known-hosts.ts",
    "src/main/terminal/credentials.ts",
    "src/main/terminal/install-public-key.ts"
  ]
}
